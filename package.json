{
  "name": "enhe-product-video-studio",
  "version": "0.1.0",
  "description": "Local HyperFrames-default product-video workflow with optional Remotion rendering, Mandarin narration, subtitles, and evidence-based QA.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangjing6213-dev/Product-video.git"
  },
  "private": true,
  "type": "module",
  "files": [
    "src",
    "schemas",
    "scripts/*.mjs",
    "scripts/*.mts",
    "scripts/*.py",
    "scripts/*.txt",
    "recipes",
    "prompts",
    "skills",
    "docs/architecture",
    "docs/guides",
    "docs/security",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "check:dependency-risk": "node scripts/check-dependency-risk.mjs",
    "video": "node src/cli.ts",
    "video:quality": "node src/quality/cli.ts",
    "ip:library": "node scripts/ip-library.mjs",
    "test": "node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "caniuse-lite": "1.0.30001810",
    "gsap": "3.14.2",
    "hyperframes": "0.8.33",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "ffprobe-static": "3.1.0",
    "puppeteer-core": "25.10.0",
    "typescript": "7.0.2"
  }
}
